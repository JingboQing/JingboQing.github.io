{
  "name": "jingbo-qing-academic-homepage",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1",
    "check": "node scripts/check-site.mjs",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "verify": "npm run build && npm run check && npm run typecheck"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "astro": "7.4.11",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "parse5": "^8.0.0",
    "typescript": "^5.9.3"
  }
}
