---
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const traces = Array.from({ length: 23 }, (_, layer) => {
  const points = Array.from({ length: 131 }, (_, i) => {
    const x = i * 5;
    const envelope = Math.exp(-Math.pow((x - 350) / 240, 2));
    const y = 72 + layer * 13 + Math.sin(x * 0.018 - layer * 0.14) * (14 + layer * 1.2) * envelope;
    return `${i ? 'L' : 'M'}${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
  return { points, opacity: 0.34 + layer / 50 };
});
---
<div class:list={['wave-study', { compact }]}>
  <svg viewBox="0 0 650 430" role="img" aria-label="波浪场概念线图 / Conceptual wave-field line drawing">
    <defs><linearGradient id={compact ? 'wave-fade-small' : 'wave-fade'} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#176069"/><stop offset="1" stop-color="#5b8581"/></linearGradient></defs>
    <g fill="none" stroke="#ced6cc" stroke-width="0.6"><path d="M40 45V385H615"/><path d="M40 130H615M40 215H615M40 300H615" stroke-dasharray="3 7"/></g>
    <g fill="none" stroke={`url(#${compact ? 'wave-fade-small' : 'wave-fade'})`} stroke-width="1.2">{traces.map(trace => <path d={trace.points} opacity={trace.opacity}/>)}</g>
    <g fill="#31585d"><circle cx="220" cy="165" r="3"/><circle cx="420" cy="232" r="3"/><circle cx="510" cy="316" r="3"/></g>
    <g fill="#506966" font-family="Georgia,serif" font-style="italic" font-size="21"><text x="603" y="414" font-weight="700">x</text><text x="16" y="58">η</text><text x="444" y="60">φ(<tspan font-weight="700">x</tspan>, t)</text></g>
  </svg>
</div>
