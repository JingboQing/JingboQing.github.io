---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import WaveStudy from '../../components/WaveStudy.astro';
import { languages, path, text, profile, posts, type Lang } from '../../lib/site';
export function getStaticPaths() { return languages.map(lang => ({ params: { lang } })); }
const lang = Astro.params.lang as Lang;
const entry = await profile(lang);
const { Content } = await render(entry);
// Only the posts marked `inOverview: true`, like `inCV` for the CV; research first, then the newest.
const entries = (await posts(lang)).filter(p => p.data.inOverview).sort((a, b) =>
  Number(b.data.type === 'research') - Number(a.data.type === 'research')
  || b.data.date.valueOf() - a.data.date.valueOf());
const academicLinks = [
  ['Google Scholar', entry.data.scholar], ['GitHub', entry.data.github],
  ['ResearchGate', entry.data.researchgate], ['ORCID', entry.data.orcid],
].filter(([, href]) => href);
---
<Layout lang={lang} title={`${entry.data.name} · ${text(lang, '个人学术主页', 'Academic homepage')}`} description={entry.data.description || `${entry.data.name} · ${entry.data.role} · ${entry.data.researchAreas.join(' / ')}`}>
  <div class="page-wrap">
    <section class="profile-section" aria-labelledby="profile-name">
      <div class="profile-content">
        <div class="profile-heading">
          <h1 id="profile-name" class="profile-name">{entry.data.name}</h1>
          {lang === 'zh' && <p class="profile-roman">Jingbo Qing</p>}
          <p class="profile-role">{entry.data.role}</p>
        </div>
        <p class="affiliations">{entry.data.affiliations.map((affiliation, i) => <><span>{affiliation}</span>{i < entry.data.affiliations.length - 1 && <span class="affiliation-divider" aria-hidden="true"> / </span>}</>)}</p>
        <div class="profile-bio prose"><Content /></div>
        <div class="profile-links">
          <a href={`mailto:${entry.data.email}`}>{text(lang, '邮件联系', 'Email')} ↗</a>
          {academicLinks.map(([label, href]) => <a href={href} target="_blank" rel="noopener noreferrer">{label} ↗</a>)}
          <a href={path(`/${lang}/cv/`)}>{entry.data.cvLabel || text(lang, '学术履历', 'CV')} →</a>
        </div>
      </div>
      <aside class="profile-aside" aria-label={text(lang, '研究方向', 'Research areas')}>
        {entry.data.photo ? <Image class="profile-photo" src={entry.data.photo} alt={entry.data.photoAlt || entry.data.name} widths={[320, 560]} sizes="320px" loading="eager" /> : <WaveStudy compact />}
        <p class="small-heading">{text(lang, '研究方向', 'RESEARCH AREAS')}</p>
        <ul class="research-areas">{entry.data.researchAreas.map(area => <li>{area}</li>)}</ul>
      </aside>
    </section>
    <section class="feed-section" aria-labelledby="feed-title">
      <div class="section-heading"><h2 id="feed-title">{text(lang, '研究与动态', 'Research & updates')}</h2><a class="text-link" href={path(`/${lang}/updates/`)}>{text(lang, '全部内容', 'View all')} <span aria-hidden="true">→</span></a></div>
      <PostList entries={entries} lang={lang} filters={false} badges={false} />
    </section>
    <section class="contact-strip"><h2>{text(lang, '欢迎就研究问题联系我。', 'Get in touch about research.')}</h2><a class="text-link" href={`mailto:${entry.data.email}`}>{entry.data.email} <span aria-hidden="true">↗</span></a></section>
  </div>
</Layout>
