---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { posts, path, postLang, postSlug, postURL, postLink, dateLabel, typeLabel, text, paperFor, isExternal, type Lang } from '../../../lib/site';
export async function getStaticPaths() {
  return (await posts()).map(post => ({ params: { lang: postLang(post), slug: postSlug(post) }, props: { post } }));
}
const { post } = Astro.props;
const lang = postLang(post) as Lang;
const { Content } = await render(post);
const alternative = (await posts()).find(p => postSlug(p) === postSlug(post) && postLang(p) !== lang);
const alternate = alternative ? postURL(alternative) : `/${lang === 'zh' ? 'en' : 'zh'}/`;
const journal = paperFor(post, await getCollection('publications'))?.data.journal;
---
<Layout lang={lang} active="updates" alternate={alternate} hasTranslation={!!alternative} title={`${post.data.title} · ${text(lang, '卿景博', 'Jingbo Qing')}`} description={post.data.summary} image={post.data.cover}>
  <article class="article-wrap">
    <a class="back-link" href={path(`/${lang}/updates/`)}>← {text(lang, '研究与动态', 'Research & updates')}</a>
    <header class="article-header"><div class="post-meta"><span class="post-type">{typeLabel(post.data.type, lang)}</span><span class="meta-dot" aria-hidden="true">·</span>{journal && <><span class="post-journal">{journal}</span><span class="meta-dot" aria-hidden="true">·</span></>}<time datetime={post.data.datePrecision === 'year' ? String(post.data.date.getUTCFullYear()) : post.data.date.toISOString().slice(0, 10)}>{dateLabel(post, lang)}</time></div><h1>{post.data.title}</h1><p class="article-summary">{post.data.summary}</p></header>
    {post.data.links.length > 0 && <nav class="resource-links" aria-label={text(lang, '相关资源', 'Related resources')}>{post.data.links.map(link => <a href={postLink(post, link.url)} target={link.url.startsWith('http') ? '_blank' : undefined} rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}>{link.label} <span aria-hidden="true">{isExternal(link.url) ? '↗' : '→'}</span></a>)}</nav>}
    {post.data.cover && post.data.coverOnPage && <figure class="article-cover"><Image src={post.data.cover} alt={post.data.coverAlt || ''} widths={[780, 1560]} sizes="(max-width: 820px) 100vw, 780px" />{post.data.coverCaption && <figcaption>{post.data.coverCaption}</figcaption>}</figure>}
    <div class="prose article-body"><Content /></div>
    <footer class="article-end"><a href={path(`/${lang}/updates/`)}>← {text(lang, '返回全部内容', 'Back to all entries')}</a>{alternative && <a href={path(postURL(alternative))} lang={lang === 'zh' ? 'en' : 'zh-CN'}>{text(lang, 'Read in English', '阅读中文')} →</a>}</footer>
  </article>
</Layout>
<script>
  // Embedded demos report their height; size their frames to fit instead of leaving blank space.
  window.addEventListener('message', (event) => {
    const data = event.data;
    if (event.origin !== location.origin || !data || data.type !== 'demo-height' || typeof data.height !== 'number') return;
    document.querySelectorAll<HTMLIFrameElement>('.prose iframe').forEach((frame) => {
      // Add the frame's own border so the content fits without an inner scrollbar.
      if (frame.contentWindow === event.source) frame.style.height = `${Math.min(Math.max(data.height + frame.offsetHeight - frame.clientHeight, 240), 3000)}px`;
    });
  });

  // Videos in a post loop silently while they are on screen, so a reader need not press play. A video the reader
  // paused stays paused, and with reduced motion nothing starts by itself; the controls remain for full screen.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('.prose video').forEach((video) => {
      video.muted = true; video.loop = true; video.playsInline = true;
      let auto = false; // the next pause comes from scrolling away, not from the reader
      let held = false; // the reader paused it
      video.addEventListener('pause', () => { if (!auto) held = true; auto = false; });
      video.addEventListener('play', () => { held = false; });
      new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) { if (!held) video.play().catch(() => {}); }
        else if (!video.paused) { auto = true; video.pause(); }
      }, { threshold: 0.25 }).observe(video);
    });
  }
</script>
