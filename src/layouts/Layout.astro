---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { path, text, profile, type Lang } from '../lib/site';
interface Props { title: string; description: string; lang?: Lang; landing?: boolean; alternate?: string; active?: string; hasTranslation?: boolean; image?: ImageMetadata; }
const { title, description, lang = 'zh', landing = false, alternate, active = 'home', hasTranslation = true, image } = Astro.props;
const otherLang = lang === 'zh' ? 'en' : 'zh';
const alternateURL = alternate || `/${otherLang}/`;
const links = [
  ['home', text(lang, '概览', 'Overview'), `/${lang}/`],
  ['publications', text(lang, '学术成果', 'Publications'), `/${lang}/publications/`],
  ['updates', text(lang, '研究与动态', 'Research & updates'), `/${lang}/updates/`],
  ['cv', text(lang, '学术履历', 'CV'), `/${lang}/cv/`],
];
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = (await profile(lang)).data;
// Share preview (WeChat, LinkedIn, X …): the page's own image if it has one, otherwise the profile photo. SVGs are skipped.
const shareSource = image && image.format !== 'svg' ? image : person.photo;
const share = shareSource ? await getImage({ src: shareSource, width: Math.min(1200, shareSource.width), format: 'jpg' }) : undefined;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <link rel="icon" href={path('/favicon.svg')} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {!landing && hasTranslation && <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={new URL(path(alternateURL), Astro.site)} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_GB'} />
    {share && <meta property="og:image" content={new URL(share.src, Astro.site)} />}
    {share && <meta property="og:image:width" content={String(share.attributes.width)} />}
    {share && <meta property="og:image:height" content={String(share.attributes.height)} />}
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
  </head>
  <body class:list={[{ 'is-landing': landing }]}>
    <a class="skip-link" href="#main">{text(lang, '跳至正文', 'Skip to content')}</a>
    {!landing && <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={path(`/${lang}/`)}><svg class="brand-mark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" aria-hidden="true"><path d="M1.5 12.3C4.5 12.3 5.8 6.8 9 6.8S13.2 12.3 16 12.3 19.2 9.4 22.5 9.4" stroke-width="1.8"/><path d="M1.5 17.2C4.5 17.2 5.8 11.7 9 11.7S13.2 17.2 16 17.2 19.2 14.3 22.5 14.3" stroke-width="1.6" opacity=".3"/></svg><span>{text(lang, '卿景博', 'Jingbo Qing')}</span></a>
        <nav aria-label={text(lang, '主导航', 'Main navigation')}>
          {links.map(([key, label, href]) => <a href={path(href)} aria-current={active === key ? 'page' : undefined}>{label}</a>)}
        </nav>
        <a class="language-switch" href={path(alternateURL)} lang={otherLang === 'zh' ? 'zh-CN' : 'en'}>{otherLang === 'zh' ? '中文' : 'English'}</a>
      </div>
    </header>}
    <main id="main" tabindex="-1"><slot /></main>
    {!landing && <footer class="site-footer">
      <a href={path('/')}>{text(lang, '语言入口', 'Language selection')}</a>
    </footer>}
  </body>
</html>
